# Токен от @BotFather
BOT_TOKEN=

# user ID владельцев бота через запятую (свой ID покажет /whereami в личке с ботом)
OWNER_IDS=

# ID групп обсуждений, где бот работает, через запятую (вида -1001234567890)
ALLOWED_CHAT_IDS=

DB_PATH=data/bot.db
LOG_LEVEL=INFO

# Прокси для связи с Telegram, если api.telegram.org недоступен напрямую. Пусто — без прокси.
# Примеры: http://host:3128, socks5://user:pass@127.0.0.1:1080
PROXY=

# polling — бот сам опрашивает Telegram, работает где угодно
# webhook — Telegram присылает обновления на WEBHOOK_BASE_URL (нужен публичный HTTPS)
MODE=polling

# Пропустить обновления, накопившиеся пока бот был выключен
DROP_PENDING_UPDATES=false

# Только для MODE=webhook
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/tg/webhook
# Пусто — сгенерируется случайный при каждом запуске
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
